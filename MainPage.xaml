<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="YomaGamingPanel.MainPage"
    BackgroundColor="#0B0714"
    Title="YOMA GAMING PANEL">

    <VerticalStackLayout
        VerticalOptions="Center"
        HorizontalOptions="Center"
        Spacing="15">

        <Label
            Text="YOMA"
            FontSize="32"
            FontAttributes="Bold"
            TextColor="#D9B4FF"
            HorizontalOptions="Center" />

        <Label
            Text="GAMING PANEL"
            FontSize="22"
            TextColor="White"
            HorizontalOptions="Center" />

        <Label
            Text="App is working!"
            FontSize="16"
            TextColor="#A879FF"
            HorizontalOptions="Center" />

    </VerticalStackLayout>
</ContentPage>
