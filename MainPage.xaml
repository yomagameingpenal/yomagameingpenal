<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="YomaGamingPanel.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#0B0714"
    Title="YOMA GAMING PANEL">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <VerticalStackLayout Spacing="4">
                <Label Text="YOMA" FontSize="32" FontAttributes="Bold"
                       TextColor="#D9B4FF" HorizontalOptions="Center"/>
                <Label Text="G A M I N G   P A N E L" FontSize="12"
                       TextColor="#A879FF" HorizontalOptions="Center"/>
                <Label Text="PERSONAL SETTINGS • TRAINING TOOLS" FontSize="10"
                       TextColor="#9387A8" HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <Border Stroke="#8D42FF" StrokeThickness="1" BackgroundColor="#171024"
                    Padding="16" StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Spacing="10">
                    <Label Text="SENSITIVITY PROFILE" TextColor="#E8D8FF"
                           FontSize="17" FontAttributes="Bold"/>
                    <Label Text="Suggested starting values (0–200 scale)" TextColor="#A99ABF" FontSize="12"/>

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="General" TextColor="White"/>
                        <Label x:Name="GeneralValue" Text="200" TextColor="#D9B4FF" Grid.Column="1"/>
                    </Grid>
                    <Slider x:Name="GeneralSlider" Minimum="0" Maximum="200" Value="200"
                            ThumbColor="#D9B4FF" MinimumTrackColor="#9A4DFF"/>

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Red Dot" TextColor="White"/>
                        <Label x:Name="RedDotValue" Text="195" TextColor="#D9B4FF" Grid.Column="1"/>
                    </Grid>
                    <Slider x:Name="RedDotSlider" Minimum="0" Maximum="200" Value="195"
                            ThumbColor="#D9B4FF" MinimumTrackColor="#9A4DFF"/>

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="2x Scope" TextColor="White"/>
                        <Label x:Name="TwoXValue" Text="185" TextColor="#D9B4FF" Grid.Column="1"/>
                    </Grid>
                    <Slider x:Name="TwoXSlider" Minimum="0" Maximum="200" Value="185"
                            ThumbColor="#D9B4FF" MinimumTrackColor="#9A4DFF"/>

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="4x Scope" TextColor="White"/>
                        <Label x:Name="FourXValue" Text="170" TextColor="#D9B4FF" Grid.Column="1"/>
                    </Grid>
                    <Slider x:Name="FourXSlider" Minimum="0" Maximum="200" Value="170"
                            ThumbColor="#D9B4FF" MinimumTrackColor="#9A4DFF"/>

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Fire Button Size" TextColor="White"/>
                        <Label x:Name="FireSizeValue" Text="45%" TextColor="#D9B4FF" Grid.Column="1"/>
                    </Grid>
                    <Slider x:Name="FireSizeSlider" Minimum="30" Maximum="70" Value="45"
                            ThumbColor="#D9B4FF" MinimumTrackColor="#9A4DFF"/>

                    <Button Text="SAVE PROFILE" Clicked="OnSaveClicked"
                            BackgroundColor="#8D42FF" TextColor="White" CornerRadius="12"/>
                    <Label x:Name="SaveStatus" Text="Values are suggestions. Tune them in Training Ground."
                           TextColor="#A99ABF" FontSize="11"/>
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Text="M1887 PRACTICE" Clicked="OnM1887Clicked"
                        BackgroundColor="#211532" TextColor="#E8D8FF"
                        BorderColor="#8D42FF" BorderWidth="1" CornerRadius="14"/>
                <Button Text="MP40 PRACTICE" Grid.Column="1" Clicked="OnMP40Clicked"
                        BackgroundColor="#211532" TextColor="#E8D8FF"
                        BorderColor="#8D42FF" BorderWidth="1" CornerRadius="14"/>
            </Grid>

            <Border Stroke="#3E2A57" StrokeThickness="1" BackgroundColor="#120C1D"
                    Padding="16" StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Spacing="10">
                    <Label Text="DRAG SHOT TRAINER" FontSize="17" FontAttributes="Bold" TextColor="#E8D8FF"/>
                    <Label Text="A short timer for practice only. It does not control or change the game."
                           TextColor="#A99ABF" FontSize="12"/>
                    <Button x:Name="PracticeButton" Text="START 10-SECOND DRILL"
                            Clicked="OnPracticeClicked" BackgroundColor="#3A2454"
                            TextColor="White" CornerRadius="12"/>
                    <Label x:Name="PracticeStatus" Text="Ready when you are." TextColor="#D9B4FF"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>

            <Label Text="Training tool only • No game modification or cheat features"
                   FontSize="10" TextColor="#756783" HorizontalOptions="Center"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
